# ── App / auth ──────────────────────────────────────────────
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated. Only these emails can sign up / sign in. Empty = nobody.
ALLOWED_EMAILS=
DATABASE_PATH=ssm.db

# Email delivery for magic links + codes. Without RESEND_API_KEY they print to the server console.
RESEND_API_KEY=
EMAIL_FROM=SSM <ssm@example.com>

# ── Azure DevOps ────────────────────────────────────────────
ADO_ORG=your-org
ADO_PROJECT=your-project
# PAT scopes: Code (Read & write), Build (Read & execute). Leave empty to use `az account get-access-token`.
ADO_PAT=
# Optional, for the az fallback: the Entra tenant your ADO identity lives in (auto-detected if empty)
ADO_TENANT=
# How the Merge button completes PRs: noFastForward | squash | rebase | rebaseMerge
ADO_MERGE_STRATEGY=noFastForward
ADO_DELETE_SOURCE_BRANCH=true
# Substrings (case/space-insensitive) matched against reviewer display/unique names
CODERABBIT_MATCH=coderabbit
QA_REVIEWER_MATCH=QA
# Comment posted to ask CodeRabbit for a review
CODERABBIT_RETRIGGER_COMMENT=@coderabbitai review
# Resolve threads that are only "@coderabbitai review" + CodeRabbit's acknowledgement (they block "Comment requirements")
CODERABBIT_AUTO_RESOLVE=true

# ── Jira Cloud ──────────────────────────────────────────────
JIRA_BASE_URL=https://your-site.atlassian.net
# Scoped API tokens only: https://api.atlassian.com/ex/jira/<cloudId>. Classic tokens: leave empty.
JIRA_API_URL=
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens — scoped tokens need read:jira-work, write:jira-work, read:jira-user
JIRA_API_TOKEN=
# Optional: restrict ticket keys parsed from PR titles, e.g. ABC,XYZ
JIRA_PROJECTS=
# Status a ticket should be in once its PR is up (quick-move button)
JIRA_PR_STATUS=IN PR
# Other statuses that are fine while a PR is open (comma-separated). Done-category is always fine.
JIRA_OK_STATUSES=
# Tickets with no PR yet
JIRA_OPEN_JQL=assignee = currentUser() AND statusCategory = "In Progress" ORDER BY updated DESC
